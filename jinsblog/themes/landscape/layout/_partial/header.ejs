<header id="header">
  <div id="banner"></div>
  <div id="header-outer" class="outer">
    <div id="header-title" class="inner">
      <h1 id="logo-wrap">
        <a href="<%- url_for() %>" id="logo"><%= config.title %></a>
      </h1>
      <% if (theme.subtitle || config.subtitle){ %>
        <h2 id="subtitle-wrap">
          <a href="<%- url_for() %>" id="subtitle"><%= theme.subtitle || config.subtitle %></a>
        </h2>
      <% } %>
    </div>
    <div id="header-inner" class="inner">
      <nav id="main-nav">
        <a id="main-nav-toggle" class="nav-icon"><span class="fa fa-bars"></span></a>
        <% if (theme.nav) { %>
          <% for (var name in theme.nav) { %>
            <% var item = theme.nav[name]; %>
            <% if (item.children) { %>
              <div class="dropdown-nav-item">
                <a class="main-nav-link dropdown-toggle"<%- item.url ? ' href="' + url_for(item.url) + '"' : '' %>><%= name %> <span class="fa fa-chevron-down"></span></a>
                <ul class="dropdown-menu">
                  <% for (var childName in item.children) { %>
                    <li><a class="main-nav-link" href="<%- url_for(item.children[childName]) %>"><%= childName %></a></li>
                  <% } %>
                </ul>
              </div>
            <% } else { %>
              <a class="main-nav-link" href="<%- url_for(item) %>"><%= name %></a>
            <% } %>
          <% } %>
        <% } else if (theme.menu) { %>
          <% for (var i in theme.menu){ %>
            <a class="main-nav-link" href="<%- url_for(theme.menu[i]) %>"><%= i %></a>
          <% } %>
        <% } %>
      </nav>
      <nav id="sub-nav">
        <a class="nav-icon lang-switch" href="javascript:void(0)" id="lang-toggle" title="<%= __('switch_lang') %>">
          <span id="lang-label">EN</span>
        </a>
        <% if (theme.links) { %>
          <% for (const i in theme.links) {%>
            <a class="nav-icon" href="<%- url_for(theme.links[i]) %>"><span class="fa fa-<%= i %>"></span></a>
          <% } %>
        <% } %>
        <% if (theme.rss){ %>
          <a class="nav-icon" href="<%- url_for(theme.rss) %>" title="<%= __('rss_feed') %>"><span class="fa fa-rss"></span></a>
        <% } %>
        <a class="nav-icon nav-search-btn" title="<%= __('search') %>"><span class="fa fa-search"></span></a>
      </nav>
      <div id="search-form-wrap">
        <div class="search-form"><input type="search" id="local-search-input" class="search-form-input" placeholder="<%= __('search') %>"><button type="button" class="search-form-submit">&#xF002;</button></div>
        <div id="local-search-result" class="local-search-result"></div>
      </div>
    </div>
  </div>
</header>
