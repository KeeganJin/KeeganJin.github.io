<%- partial('_partial/article', {post: page, index: false}) %>

<% if (page.categories && page.categories.length) { %>
  <%
    // Get the top-level category (first in the hierarchy)
    var cats = page.categories.toArray();
    var topCategory = cats[0];

    // Try to find a subcategory for the meta label
    var subCategory = cats.length > 1 ? cats[cats.length - 1] : null;

    // Find related posts in the same top-level category
    var related = [];
    if (topCategory) {
      var catObj = site.categories.findOne({name: topCategory.name});
      if (catObj && catObj.posts) {
        catObj.posts.each(function(p) {
          if (p._id !== page._id) {
            related.push(p);
          }
        });
      }
    }
  %>
  <% if (related.length > 0) { %>
  <section class="category-posts-sidebar">
    <h3><%= __('related_articles') %> — <%= topCategory.name %></h3>
    <ul class="category-posts-list">
      <% for (var i = 0; i < related.length; i++) { %>
        <% var p = related[i]; %>
        <% var pCats = p.categories.toArray(); %>
        <% var pSub = pCats.length > 1 ? pCats[pCats.length - 1] : null; %>
        <li>
          <a href="<%- url_for(p.path) %>"><%= p.title %></a>
          <% if (pSub) { %>
            <span class="category-post-meta">[<%= pSub.name %>]</span>
          <% } %>
        </li>
      <% } %>
    </ul>
  </section>
  <% } %>
<% } %>
