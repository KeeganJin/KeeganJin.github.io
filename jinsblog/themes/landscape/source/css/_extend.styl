// ========================================
// Nordic Zen Extensions (北欧极简白扩展样式)
// ========================================

$block-caption
  text-decoration: none
  text-transform: uppercase
  letter-spacing: 2px
  color: color-grey
  margin-bottom: 1em
  margin-left: 5px
  line-height: 1em
  font-weight: 600
  font-family: font-sans
  font-size: 12px

$block
  background: #FFFFFF
  border: 1px solid color-border
  border-radius: radius-md
  transition: all 0.3s ease
  &:hover
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08)

$base-style
  h1
    font-size: 2em
  h2
    font-size: 1.5em
  h3
    font-size: 1.3em
  h4
    font-size: 1.2em
  h5
    font-size: 1em
  h6
    font-size: 1em
    color: color-grey
  hr
    border: none
    border-top: 1px dashed color-border
    margin: 1.5em 0
  strong
    font-weight: 700
  em, cite
    font-style: italic
  sup, sub
    font-size: 0.75em
    line-height: 0
    position: relative
    vertical-align: baseline
  sup
    top: -0.5em
  sub
    bottom: -0.2em
  small
    font-size: 0.85em
  acronym, abbr
    border-bottom: 1px dotted
    cursor: help
  ul, ol, dl
    margin: 0 24px
    line-height: line-height
  ul, ol
    ul, ol
      margin-top: 0
      margin-bottom: 0
  ul
    list-style: disc
  ol
    list-style: decimal
  dt
    font-weight: 700