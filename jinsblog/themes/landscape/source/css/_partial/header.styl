// ========================================
// Nordic Zen Header (北欧极简白头部)
// ========================================
// Clean, minimal, text-based header without banner

#header
  height: auto
  padding: 48px 0 32px
  background: #FFFFFF
  border-bottom: 1px solid color-border
  position: relative
  &:before, &:after
    content: none  // 移除渐变效果

#header-outer
  height: auto
  position: relative

#header-inner
  position: relative
  overflow: hidden
  display: flex
  flex-direction: column
  align-items: center
  justify-content: center
  text-align: center

// Banner removed for clean Nordic style
#banner
  display: none

// Title area - centered, elegant serif
#header-title
  text-align: center
  position: relative
  margin-bottom: 24px

$logo-text
  text-decoration: none
  color: #1A202C  // 深色标题
  font-weight: 700
  text-shadow: none

#logo
  @extend $logo-text
  font-family: font-serif
  font-size: logo-size
  line-height: logo-size
  letter-spacing: 3px
  transition: color 0.3s ease
  &:hover
    color: color-link

#subtitle
  @extend $logo-text
  font-family: font-serif
  font-size: subtitle-size
  line-height: subtitle-size
  letter-spacing: 2px
  color: color-grey
  font-weight: 400
  margin-top: 8px
  opacity: 0.8

#subtitle-wrap
  margin-top: subtitle-size

// Navigation - clean underline style
#main-nav
  float: none
  text-align: center
  margin-left: 0

$nav-link
  color: color-default
  text-decoration: none
  transition: all 0.3s ease
  display: inline-block
  padding: 12px 20px
  font-family: font-sans
  font-size: 14px
  font-weight: 500
  letter-spacing: 1px
  position: relative
  &:hover
    color: color-link
  &.active
    color: color-link
    &:after
      content: ''
      position: absolute
      bottom: 0
      left: 50%
      transform: translateX(-50%)
      width: 24px
      height: 2px
      background: color-link
      border-radius: 1px

.nav-icon
  @extend $nav-link
  text-align: center
  font-size: font-size
  width: auto
  height: auto
  padding: 12px 15px
  position: relative
  cursor: pointer

.lang-switch
  font-size: 12px
  font-weight: bold
  width: auto
  span
    padding: 4px 8px
    border: 1px solid color-border
    border-radius: 4px
    transition: all 0.3s ease
    &:hover
      border-color: color-link
      color: color-link

.main-nav-link
  @extend $nav-link
  @media mq-mobile
    display: none

#main-nav-toggle
  display: none
  @media mq-mobile
    display: block
    position: absolute
    top: 20px
    left: 20px

#sub-nav
  float: none
  text-align: center
  margin-right: 0
  margin-top: 16px

// Search form - minimal style
#search-form-wrap
  position: relative
  width: 200px
  margin: 0 auto
  opacity: 1
  right: 0
  transition: 0.3s ease-out
  @media mq-mobile
    width: 100%

.search-form
  background: color-background
  padding: 8px 16px
  border-radius: radius-md
  border: 1px solid color-border
  transition: all 0.3s ease
  &:hover, &:focus-within
    border-color: color-link

.search-form-input
  border: none
  background: none
  color: color-default
  width: 100%
  font: 14px font-sans
  outline: none
  &::-webkit-search-results-decoration
  &::-webkit-search-cancel-button
    -webkit-appearance: none

.search-form-submit
  position: absolute
  top: 50%
  right: 12px
  margin-top: -7px
  font: 14px font-icon
  border: none
  background: none
  color: color-grey
  cursor: pointer
  transition: color 0.3s ease
  &:hover, &:focus
    color: color-link

// Social links in header
.header-link
  color: color-grey
  font-size: 16px
  padding: 8px 12px
  transition: color 0.3s ease
  &:hover
    color: color-link