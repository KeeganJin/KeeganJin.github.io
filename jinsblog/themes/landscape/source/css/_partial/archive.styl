// ========================================
// Nordic Zen Archive (北欧极简白归档页)
// ========================================

.archives-wrap
  margin: block-margin 0

.archives
  clearfix()

.archive-year-wrap
  margin-bottom: 1.5em

.archive-year
  @extend $block-caption
  font-size: 14px
  color: #1A202C
  font-weight: 700
  letter-spacing: 3px

.archives
  column-gap: 20px
  @media mq-tablet
    column-count: 2
  @media mq-normal
    column-count: 3

.archive-article
  avoid-column-break()

.archive-article-inner
  @extend $block
  padding: 16px
  margin-bottom: 16px
  border-radius: radius-md

.archive-article-title
  text-decoration: none
  font-family: font-serif
  font-weight: 700
  font-size: 16px
  color: #1A202C
  transition: color 0.3s ease
  line-height: 1.4
  display: block
  &:hover
    color: color-link

.archive-article-footer
  margin-top: 8px
  font-family: font-sans

.archive-article-date
  color: color-grey
  text-decoration: none
  font-size: 13px
  font-family: font-sans
  line-height: 1em
  margin-bottom: 8px
  display: block

#page-nav
  clearfix()
  margin: block-margin auto
  background: #FFFFFF
  border: 1px solid color-border
  border-radius: radius-md
  text-align: center
  color: color-grey
  overflow: hidden
  font-family: font-sans
  a, span
    padding: 12px 20px
    line-height: 1
    display: inline-block
    transition: all 0.3s ease
  a
    color: color-grey
    text-decoration: none
    &:hover
      background: color-link
      color: #FFFFFF
      border-radius: radius-md
  .prev
    float: left
    border-right: 1px solid color-border
  .next
    float: right
    border-left: 1px solid color-border
  .page-number
    display: inline-block
    @media mq-mobile
      display: none
  .current
    color: color-link
    font-weight: 700
    background: color-widget-background
  .space
    color: color-border