// ========================================
// Nordic Zen Code Highlight (北欧极简白代码高亮)
// ========================================
// Warm, readable code blocks with Fira Code

highlight-background = #F7F5F2  // 温暖米白背景
highlight-current-line = #E2E8F0
highlight-selection = #E2E8F0
highlight-foreground = #2D3748
highlight-comment = #64748B
highlight-red = #B87D4B  // 暖赭色
highlight-orange = #C97B4B
highlight-yellow = #A68B5B
highlight-green = #2B5F43  // 森林绿
highlight-aqua = #5B8A72
highlight-blue = #4A6FA5
highlight-purple = #7B6B8D

$code-block
  background: highlight-background
  margin: 1em article-padding * -1
  padding: 20px article-padding
  border-style: solid
  border-color: color-border
  border-width: 1px 0
  border-radius: 0
  overflow: auto
  color: highlight-foreground
  line-height: 1.6
  font-family: font-mono
  font-size: 14px

$line-numbers
  color: color-grey
  font-size: 13px
  font-family: font-mono

.article-entry
  pre, code
    font-family: font-mono
  code
    background: color-widget-background
    padding: 2px 6px
    border-radius: radius-sm
    font-size: 0.9em
    color: highlight-red
  pre
    @extend $code-block
    code
      background: none
      padding: 0
  .highlight
    @extend $code-block
    margin: 1.5em article-padding * -1
    border-radius: radius-md
    pre
      border: none
      margin: 0
      padding: 0
    table
      margin: 0
      width: auto
    td
      border: none
      padding: 0
    figcaption
      clearfix()
      font-size: 0.85em
      color: highlight-comment
      line-height: 1em
      margin-bottom: 1em
      font-family: font-sans
      a
        float: right
        color: color-link
    .gutter
      -moz-user-select: none
      -ms-user-select: none
      -webkit-user-select: none
      user-select: none
      pre
        @extend $line-numbers
        text-align: right
        padding-right: 20px
    .line
      height: 22px
    .line.marked
      background: highlight-selection
  .gist
    margin: 1em article-padding * -1
    border-style: solid
    border-color: color-border
    border-width: 1px 0
    background: highlight-background
    padding: 20px article-padding 20px 0
    border-radius: radius-md
    .gist-file
      border: none
      font-family: font-mono
      margin: 0
      .gist-data
        background: none
        border: none
        .line-numbers
          @extend $line-numbers
          background: none
          border: none
          padding: 0 20px 0 0
        .line-data
          padding: 0 !important
      .highlight
        margin: 0
        padding: 0
        border: none
      .gist-meta
        background: highlight-background
        color: highlight-comment
        font: 0.85em font-sans
        padding: 0
        margin-top: 1em
        margin-left: article-padding
        a
          color: color-link
          font-weight: normal
          &:hover
            text-decoration: underline

// Syntax highlighting colors
pre
  .comment
  .title
    color: highlight-comment
  .variable
  .attribute
  .tag
  .regexp
  .ruby .constant
  .xml .tag .title
  .xml .pi
  .xml .doctype
  .html .doctype
  .css .id
  .css .class
  .css .pseudo
    color: highlight-red
  .number
  .preprocessor
  .built_in
  .literal
  .params
  .constant
    color: highlight-orange
  .class
  .ruby .class .title
  .css .rules .attribute
    color: highlight-green
  .string
  .value
  .inheritance
  .header
  .ruby .symbol
  .xml .cdata
    color: highlight-green
  .css .hexcolor
    color: highlight-aqua
  .function
  .python .decorator
  .python .title
  .ruby .function .title
  .ruby .title .keyword
  .perl .sub
  .javascript .title
  .coffeescript .title
    color: highlight-blue
  .keyword
  .javascript .function
    color: highlight-purple