.widget
  @extend $base-style
  line-height: 1.6
  word-wrap: break-word
  font-family: font-sans
  font-size: 13px
  ul, ol
    list-style: none
    margin: 0
    padding: 0
    ul, ol
      margin-left: 16px
      list-style: none

.category-list-count
.tag-list-count
.archive-list-count
  font-size: 11px
  color: color-grey

.tagcloud
  display: flex
  flex-wrap: wrap
  gap: 6px
  a
    display: inline-block
    padding: 3px 10px
    background: #FFFFFF
    color: color-grey
    border: 1px solid color-border
    border-radius: radius-sm
    font-size: 11px
    transition: all 0.3s ease
    &:hover
      background: color-link
      color: #FFFFFF
      border-color: color-link