// ========================================
// Nordic Zen Mobile (北欧极简白移动端)
// ========================================

@media mq-mobile
  #header
    padding: 32px 0 24px

  #header-inner
    padding: 0 20px

  #logo
    font-size: 24px

  #subtitle
    font-size: 12px

  #main-nav
    display: none

  #main-nav-toggle
    display: block
    position: absolute
    top: 24px
    left: 20px
    color: color-default
    font-size: 20px
    cursor: pointer

  #sub-nav
    margin-top: 12px

  .article-inner
    border-radius: 0
    margin: 0 -20px

  .article-title
    font-size: 1.4em

  .article-entry
    padding: 0 16px
    font-size: 14px
    line-height: 1.6

  #sidebar
    display: none

  .widget
    border-radius: 0

  #footer
    padding: 24px 20px

@media mq-mobile
  #mobile-nav
    position: absolute
    top: 0
    left: 0
    width: mobile-nav-width
    height: 100%
    background: color-background
    border-right: 1px solid color-border
    box-shadow: 2px 0 8px rgba(0, 0, 0, 0.1)
    overflow-y: auto

@media mq-mobile
  .mobile-nav-link
    display: block
    color: color-default
    text-decoration: none
    padding: 16px 20px
    font-family: font-sans
    font-weight: 500
    font-size: 14px
    letter-spacing: 1px
    border-bottom: 1px solid color-border
    transition: all 0.3s ease
    &:hover
      color: color-link
      background: color-widget-background
    &:active
      background: color-link
      color: #FFFFFF

// Mobile nav widgets (侧边栏内容在移动端导航中)
@media mq-mobile
  .mobile-nav-widgets
    padding: 20px

    .widget-wrap
      margin: 16px 0
      &:first-child
        margin-top: 24px

    .widget-title
      font-family: font-serif
      font-size: 13px
      font-weight: 700
      color: #1A202C
      margin-bottom: 10px
      padding-bottom: 6px
      border-bottom: 2px solid color-link

    .widget
      font-size: 13px

      a
        display: block
        padding: 8px 0
        color: color-default
        text-decoration: none
        transition: color 0.3s ease
        &:hover
          color: color-link

      ul, ol
        list-style: none
        margin: 0
        padding: 0

    // Category in mobile nav
    .category-list
      .category-list-item
        margin-bottom: 4px

      .category-list-link
        font-size: 13px
        padding: 8px 0

      .category-list-child
        padding-left: 12px
        border-left: 1px solid color-border
        margin-top: 4px

    // Recent posts in mobile nav
    .recent-posts-list
      .recent-posts-item
        margin-bottom: 8px

      .recent-posts-link
        font-family: font-serif
        font-size: 13px
        padding: 6px 0
        border-bottom: 1px solid color-border

    // Archive in mobile nav
    .archive-list
      .archive-list-item
        margin-bottom: 4px

      .archive-list-link
        font-size: 13px
        padding: 6px 0

@media mq-tablet
  .article-inner
    border-radius: radius-md

  #sidebar
    display: block