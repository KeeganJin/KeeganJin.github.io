// ========================================
// Nordic Zen Mobile (北欧极简白移动端)
// ========================================

@media mq-mobile
  #header
    padding: 32px 0 24px

  #header-inner
    padding: 0 20px

  #logo
    font-size: 24px

  #subtitle
    font-size: 12px

  #main-nav
    display: none

  #main-nav-toggle
    display: block
    position: absolute
    top: 24px
    left: 20px
    color: color-default
    font-size: 20px
    cursor: pointer

  #sub-nav
    margin-top: 12px

  .article-inner
    border-radius: 0
    margin: 0 -20px

  .article-title
    font-size: 1.4em

  .article-entry
    padding: 0 16px
    font-size: 14px
    line-height: 1.6

  #sidebar
    display: none

  .widget
    border-radius: 0

  #footer
    padding: 24px 20px

@media mq-mobile
  #mobile-nav
    position: absolute
    top: 0
    left: 0
    width: mobile-nav-width
    height: 100%
    background: color-background
    border-right: 1px solid color-border
    box-shadow: 2px 0 8px rgba(0, 0, 0, 0.1)
    overflow-y: auto

@media mq-mobile
  .mobile-nav-link
    display: block
    color: color-default
    text-decoration: none
    padding: 16px 20px
    font-family: font-sans
    font-weight: 500
    font-size: 14px
    letter-spacing: 1px
    border-bottom: 1px solid color-border
    transition: all 0.3s ease
    &:hover
      color: color-link
      background: color-widget-background
    &:active
      background: color-link
      color: #FFFFFF

@media mq-tablet
  .article-inner
    border-radius: radius-md

  #sidebar
    display: block